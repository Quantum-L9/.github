{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Quantum-L9/.github/settings/settings.schema.json",
  "title": "L9 GitHub settings as code",
  "description": "Shape of settings/org.yml and settings/repos/<repository>.yml. Values are declarations of the wanted live state. The literal string UNKNOWN marks a setting that is not declared (it was unreadable when the declaration was populated, or it is not yet decided); the applier never writes an UNKNOWN setting. Secret and variable VALUES are never declared: an environment may name required secrets for a presence check only.",
  "oneOf": [{ "$ref": "#/$defs/org" }, { "$ref": "#/$defs/repo" }],
  "$defs": {
    "unknown": { "const": "UNKNOWN" },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "method"],
      "properties": {
        "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
        "method": { "type": "string", "minLength": 1 },
        "unreadable": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z_/{}]+$" }
        },
        "decided": {
          "description": "Fields under an unreadable section that carry a recorded decision rather than an observation (dotted path, e.g. actions.access_level).",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z_]+\\.[a-z_]+$" }
        }
      }
    },
    "org": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "organization", "applier", "org_rulesets"],
      "properties": {
        "schema": { "const": "l9.github-settings.org/v1" },
        "organization": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" },
        "applier": {
          "type": "object",
          "additionalProperties": false,
          "required": ["app_id", "credential_repository", "environment", "workflow"],
          "properties": {
            "app_id": { "type": "integer", "minimum": 1 },
            "credential_repository": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
            "environment": { "type": "string", "minLength": 1 },
            "workflow": { "type": "string", "pattern": "^\\.github/workflows/[A-Za-z0-9._-]+\\.ya?ml$" }
          }
        },
        "org_rulesets": {
          "description": "Organization rulesets are owned by rulesets/ and applied by scripts/apply-rulesets.sh; they are referenced here, never redeclared.",
          "type": "object",
          "additionalProperties": false,
          "required": ["owner"],
          "properties": { "owner": { "const": "rulesets/" } }
        }
      }
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "repository", "observed", "visibility", "merge", "actions", "environments", "rulesets"],
      "properties": {
        "schema": { "const": "l9.github-settings.repo/v1" },
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "observed": { "$ref": "#/$defs/observed" },
        "visibility": { "oneOf": [{ "enum": ["public", "private", "internal"] }, { "$ref": "#/$defs/unknown" }] },
        "merge": { "oneOf": [{ "$ref": "#/$defs/merge" }, { "$ref": "#/$defs/unknown" }] },
        "actions": { "oneOf": [{ "$ref": "#/$defs/actions" }, { "$ref": "#/$defs/unknown" }] },
        "environments": {
          "oneOf": [
            { "type": "array", "items": { "$ref": "#/$defs/environment" } },
            { "$ref": "#/$defs/unknown" }
          ]
        },
        "rulesets": {
          "description": "Repository-level rulesets the applier manages, matched by name. A live repository ruleset that is not listed is reported as unmanaged and never deleted.",
          "oneOf": [
            { "type": "array", "items": { "$ref": "#/$defs/ruleset" } },
            { "$ref": "#/$defs/unknown" }
          ]
        }
      }
    },
    "bool_or_unknown": { "oneOf": [{ "type": "boolean" }, { "$ref": "#/$defs/unknown" }] },
    "merge": {
      "type": "object",
      "additionalProperties": false,
      "description": "Every merge setting is required: one the declaration does not manage is written as UNKNOWN, so an omission can never hide a policy conflict.",
      "required": [
        "allow_merge_commit",
        "allow_squash_merge",
        "allow_rebase_merge",
        "allow_auto_merge",
        "allow_update_branch",
        "delete_branch_on_merge",
        "web_commit_signoff_required",
        "squash_merge_commit_title",
        "squash_merge_commit_message",
        "merge_commit_title",
        "merge_commit_message"
      ],
      "properties": {
        "allow_merge_commit": { "$ref": "#/$defs/bool_or_unknown" },
        "allow_squash_merge": { "$ref": "#/$defs/bool_or_unknown" },
        "allow_rebase_merge": { "$ref": "#/$defs/bool_or_unknown" },
        "allow_auto_merge": { "$ref": "#/$defs/bool_or_unknown" },
        "allow_update_branch": { "$ref": "#/$defs/bool_or_unknown" },
        "delete_branch_on_merge": { "$ref": "#/$defs/bool_or_unknown" },
        "web_commit_signoff_required": { "$ref": "#/$defs/bool_or_unknown" },
        "squash_merge_commit_title": { "oneOf": [{ "enum": ["PR_TITLE", "COMMIT_OR_PR_TITLE"] }, { "$ref": "#/$defs/unknown" }] },
        "squash_merge_commit_message": { "oneOf": [{ "enum": ["PR_BODY", "COMMIT_MESSAGES", "BLANK"] }, { "$ref": "#/$defs/unknown" }] },
        "merge_commit_title": { "oneOf": [{ "enum": ["PR_TITLE", "MERGE_MESSAGE"] }, { "$ref": "#/$defs/unknown" }] },
        "merge_commit_message": { "oneOf": [{ "enum": ["PR_BODY", "PR_TITLE", "BLANK"] }, { "$ref": "#/$defs/unknown" }] }
      }
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["access_level", "default_workflow_permissions", "can_approve_pull_request_reviews"],
      "properties": {
        "access_level": {
          "description": "Who outside this repository may use its actions and reusable workflows (GitHub applies it to private and internal repositories only).",
          "oneOf": [{ "enum": ["none", "user", "organization"] }, { "$ref": "#/$defs/unknown" }]
        },
        "default_workflow_permissions": { "oneOf": [{ "enum": ["read", "write"] }, { "$ref": "#/$defs/unknown" }] },
        "can_approve_pull_request_reviews": { "$ref": "#/$defs/bool_or_unknown" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "deployment_branch_policy", "wait_timer", "prevent_self_review", "reviewers", "required_secrets"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "deployment_branch_policy": {
          "oneOf": [
            { "const": "none" },
            { "$ref": "#/$defs/unknown" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["protected_branches"],
              "properties": {
                "protected_branches": { "type": "boolean" },
                "custom_branches": {
                  "type": "array",
                  "uniqueItems": true,
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          ]
        },
        "wait_timer": { "oneOf": [{ "type": "integer", "minimum": 0, "maximum": 43200 }, { "$ref": "#/$defs/unknown" }] },
        "prevent_self_review": { "$ref": "#/$defs/bool_or_unknown" },
        "reviewers": {
          "oneOf": [
            {
              "type": "array",
              "maxItems": 6,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "name"],
                "properties": {
                  "type": { "enum": ["User", "Team"] },
                  "name": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
                }
              }
            },
            { "$ref": "#/$defs/unknown" }
          ]
        },
        "required_secrets": {
          "description": "Secret NAMES whose presence is checked. Never a value.",
          "oneOf": [
            {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" }
            },
            { "$ref": "#/$defs/unknown" }
          ]
        }
      }
    },
    "ruleset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "target", "enforcement", "conditions", "rules", "bypass_actors"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "target": { "enum": ["branch", "tag", "push"] },
        "enforcement": { "enum": ["active", "disabled", "evaluate"] },
        "conditions": { "type": "object" },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
              "type": { "type": "string", "pattern": "^[a-z_]+$" },
              "parameters": { "type": "object" }
            }
          }
        },
        "bypass_actors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["actor_id", "actor_type", "bypass_mode"],
            "properties": {
              "actor_id": { "type": ["integer", "null"] },
              "actor_type": { "enum": ["Integration", "OrganizationAdmin", "RepositoryRole", "Team", "DeployKey", "EnterpriseOwner"] },
              "bypass_mode": { "enum": ["always", "pull_request", "exempt"] }
            }
          }
        }
      }
    }
  }
}
