        "id": "l9.pattern/global-fixture-domain-binding@1",
        "purpose": "Define reusable global fixture templates and specialize them through domain-specific bindings without duplicating global semantic law.\n",
        "structure": {
          "nodes": [
            "global_fixture_template",
            "domain_binding",
            "mixed_fixture"
          ]
        }
      },
      {
