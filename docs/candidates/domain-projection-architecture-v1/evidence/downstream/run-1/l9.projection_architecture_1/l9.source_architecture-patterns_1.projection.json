        }
      },
      {
        "class": "compiler",
        "compatible_with": [
          "l9.pattern/proof-carrying-stage-state@1",
          "l9.pattern/incremental-semantic-recompilation@1"
        ],
        "formula": {
          "candidate": {
            "expression": "Candidate_(n+1) = Compile_(n+1)(C_n, Input_(n+1))"
          },
          "commit": {
            "expression": "S_(n+1) = Commit(S_n, Candidate_(n+1), Receipt_(n+1)) iff Receipt_(n+1) = PASS\n"
          },
          "context": {
            "expression": "C_n = π_stage(S_n)"
          },
          "validation": {
            "expression": "Receipt_(n+1) = Validate_(Solver(n+1))(Candidate_(n+1), C_n)\n"
          }
        },
        "guarantees": [
          "bounded_stage_context",
          "early_error_localization",
          "validated_outputs_feed_next_stage",
          "downstream_stage_cannot_advance_over_failed_stage"
        ],
        "id": "l9.pattern/stage-scoped-semantic-compilation@1",
        "purpose": "Build complex artifacts incrementally through ordered validated semantic stages, projecting only the minimum sufficient upstream semantics into each stage.\n"
