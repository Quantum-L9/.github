          "probably_ok",
          "llm_opinion_as_mechanical_validation"
        ],
        "guarantees": [
          "validator_identity_is_receiptable",
          "validation_is_profile_bound",
          "failures_are_stage_local_when_possible"
        ],
        "id": "l9.pattern/stage-specific-mechanical-validation@1",
        "purpose": "Validate each semantic compilation stage using only the solver declared for that stage by the canonical compilation profile.\n",
        "solver_selection": {
