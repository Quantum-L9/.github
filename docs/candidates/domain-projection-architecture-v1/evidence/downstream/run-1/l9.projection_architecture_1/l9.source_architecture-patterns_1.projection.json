        "class": "projection",
        "compatible_with": [
          "l9.pattern/canonical-source-derived-projections@1"
        ],
        "guarantees": [
          "fewer_duplicate_ledgers",
          "mechanically_detectable_staleness",
          "consumer_specific_views"
        ],
        "id": "l9.pattern/facts-plus-lineage-compiled-views@1",
        "invariant": {
          "expression": "Store(Facts + Lineage); Compile(Views)"
        },
        "purpose": "Store canonical facts and their provenance once and generate multiple views rather than maintaining duplicated representations manually.\n"
      },
      {
        "class": "governance",
        "guarantees": [
          "capability_existence_is_not_permission",
          "unavailable_capability_remains_structurally_known",
          "agent_views_are_derived_not_independent_truth"
        ],
        "id": "l9.pattern/capability-owner-admission-projection@1",
        "layers": [
          "capability_owner_declaration",
          "admission_runtime_state",
