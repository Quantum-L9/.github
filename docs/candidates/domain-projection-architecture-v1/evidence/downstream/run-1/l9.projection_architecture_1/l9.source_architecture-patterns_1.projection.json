        "id": "l9.pattern/proof-carrying-stage-state@1",
        "purpose": "Bind each admitted compilation-stage artifact to provenance, source digests, validation evidence, profile identity, and state revision.\n",
        "required_components": [
          "artifact_digest",
          "provenance",
          "validation_receipt",
          "source_digests",
          "compilation_profile_digest",
          "state_revision"
        ]
      },
