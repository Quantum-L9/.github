        "purpose": "Separate semantic capability declaration, runtime admission, and consumer-specific capability visibility.\n",
        "relations": {
          "authorized": {
            "implication_to_available": false
          },
          "available": {
            "implication_to_authorized": false
          },
          "declared": {
            "implication_to_available": false
          }
        }
      },
      {
        "class": "projection",
        "examples": [
          "agent_capability_projection",
          "workflow_projection",
          "context_bundle"
        ],
        "guarantees": [
          "cache_correctness_does_not_depend_on_ttl",
          "changed_governing_input_yields_new_digest",
          "cache_has_zero_authority"
        ],
        "id": "l9.pattern/session-projection-cache@1",
        "purpose": "Materialize digest-addressed derived projections for fast reuse while preserving authoritative source validation.\n",
        "structure": {
          "nodes": [
            "canonical_inputs",
            "projection_compiler",
            "digest",
            "cache",
            "projected_view"
          ]
        },
        "validity": {
