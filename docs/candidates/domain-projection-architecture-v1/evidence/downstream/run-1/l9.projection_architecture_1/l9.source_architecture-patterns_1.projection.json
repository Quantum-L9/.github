          "identify_repeated_semantics",
          "emit_globalization_candidate",
          "request_authorized_global_state_change",
          "admit_global_invariant_or_contract",
          "compile_global_law",
          "derive_global_fixture",
          "publish_global_profile"
        ]
      }
    ]
