            "each_governing_composition_contract_id_and_its_catalog_digest_are_recorded",
            "the_projection_and_composition_engine_identity_and_version_are_recorded",
            "digests_use_the_canonical_json_and_semantic_digest_conventions_of_l9_compiler_projection_engine_at_1"
          ],
          "scope": "global",
          "source_invariants": [
            "L9-PROV-001",
            "L9-COORD-001",
            "L9-REVISION-001",
            "L9-DERIVED-001",
            "L9-EVIDENCE-001",
            "L9-UNKNOWN-001"
          ]
        }
      ]
    },
    "invariants": {
      "invariants": [
        {
          "id": "L9-AUTH-001",
          "owner": "Quantum-L9/.github",
          "scope": "global",
          "statement": "No component may expand its own authority.\n"
        },
        {
          "id": "L9-DERIVED-001",
          "owner": "Quantum-L9/.github",
          "scope": "global",
          "statement": "Derived artifacts do not become canonical authority automatically.\n"
        },
        {
          "id": "L9-EVIDENCE-001",
          "owner": "Quantum-L9/.github",
          "scope": "global",
          "statement": "Evidence and receipts attest only to the observations or outcomes declared by their contracts; they confer neither semantic nor execution authority.\n"
        },
        {
          "id": "L9-ASSURANCE-001",
          "owner": "Quantum-L9/.github",
          "scope": "global",
          "statement": "Normative requirement, implementation state, and assurance state are distinct. A claim that a requirement or control is implemented, verified, blocking, conformant, or complete requires current, independently verifiable evidence appropriate to that claim; missing, stale, or unverifiable required evidence leaves the claim unverified or unknown.\n"
        },
        {
          "id": "L9-UNKNOWN-001",
          "owner": "Quantum-L9/.github",
          "scope": "global",
          "statement": "Missing, unknown, unresolved, conflicting, unavailable, or unproven inputs, claims, or results remain explicit; they must not be silently coerced, reconciled, or treated as establishing a value, compatibility, validity, authorization, or success. An applicable authoritative rule may resolve a conflict, but authority does not manufacture missing evidence or establish an unproven claim.\n"
        },
        {
          "id": "L9-PROV-001",
          "owner": "Quantum-L9/.github",
          "scope": "global",
          "statement": "Every derived semantic artifact must preserve enough provenance to resolve its authoritative inputs and the declared transformations and coordinates that produced it.\n"
        },
        {
          "id": "L9-COORD-001",
          "owner": "Quantum-L9/.github",
          "scope": "global",
          "statement": "A derived result is valid only against its declared governing coordinates; a material coordinate change makes it non-current until compatibility is proven or it is recomputed.\n"
        },
        {
          "id": "L9-COMPAT-001",
          "owner": "Quantum-L9/.github",
          "scope": "global",
          "statement": "Semantic equivalence and compatibility must be declared by the applicable type or contract; similarity, convenience, or successful execution must not substitute for them.\n"
        },
        {
          "id": "L9-REVISION-001",
          "owner": "Quantum-L9/.github",
          "scope": "global",
          "statement": "The semantic content of an admitted revision is immutable; correction or change creates a successor or supersession rather than rewriting prior meaning.\n"
        },
        {
          "id": "L9-ADMISSION-001",
          "owner": "Quantum-L9/.github",
          "scope": "global",
          "statement": "Authority and admission decisions are bound to the exact subject revision they evaluate; a material change to that subject requires a new decision unless an explicit governing contract preserves compatibility.\n"
        },
        {
          "id": "L9-PROJECTION-001",
          "owner": "Quantum-L9/.github",
          "scope": "global",
          "statement": "A projection is a bounded view of existing source semantics; it may select or reshape representation but may not invent, reconcile, reinterpret, or expand source meaning or authority. A transformation that introduces semantic consequences is not projection and must be classified under another applicable governed operation.\n"
        },
        {
          "id": "L9-CORRECTNESS-001",
          "owner": "Quantum-L9/.github",
          "scope": "global",
          "statement": "A candidate, implementation, or generated artifact cannot define or establish its own correctness; correctness must be evaluated against governing criteria whose authority does not derive from the candidate or the process that produced it.\n"
        },
        {
          "id": "L9-IDENTITY-006",
          "owner": "Quantum-L9/.github",
          "scope": "global",
          "statement": "IdentityAssertion must preserve the exact evidence, resolver, governing coordinates, and provenance supporting the resolved identity dimensions; material evidence or coordinate change invalidates currentness."
        }
      ]
    },
    "receipt_catalog": {
      "global_rules": {
        "declared_observation_or_outcome_is_required": true,
        "exact_subject_binding_is_required": true,
        "material_subject_change_makes_prior_receipt_non_current_unless_compatibility_preserves_it": true,
        "materially_governing_coordinates_must_be_bound": true,
        "receipt_claim_scope_must_be_explicit": true,
        "receipt_content_is_immutable_by_digest": true,
        "receipt_digest_is_required": true,
        "receipt_does_not_grant_execution_authority": true,
        "receipt_does_not_grant_semantic_authority": true,
        "receipt_family_registration_does_not_transfer_domain_semantic_ownership": true,
        "receipt_is_evidence": true,
        "receipt_lifecycle_is_defined_separately": true,
        "receipt_presence_does_not_imply_capability_admission_availability_authorization_or_invocability": true,
        "result_semantics_remain_owned_by_the_applicable_contract_or_taxonomy": true,
        "verification_must_not_depend_only_on_the_recorded_verdict": true
      },
      "receipt_kernel": {
        "authority": {
          "class": "evidence",
          "grants_execution_authority": false,
          "grants_semantic_authority": false,
          "may_replace_admission_decision": false
        },
        "currentness": {
          "currentness_is_authority": false,
          "rule": "Currentness is evaluated against the receipt's governing coordinates. A material coordinate or subject change makes the receipt non-current unless an explicit compatibility contract preserves applicability.\n"
        },
        "field_semantics": {
          "claim": "Bounded assertion the receipt is evidence for. The claim must not exceed the observation, evaluation, or decision actually evidenced.\n",
          "exact_subject_ref": "Exact artifact, operation, decision, implementation, repository revision, or other subject to which the receipt's claim applies.\n",
          "governing_coordinates": "Revisions, digests, profiles, rulesets, bindings, source identities, or other coordinates material to the claim's validity.\n",
          "observation_or_outcome": "The observation or outcome recorded under the applicable family contract. This field does not create a global result taxonomy.\n",
          "producer_identity": "Identity of the component, authority, validator, or executor that emitted the receipt. Producer identity does not imply semantic ownership.\n",
          "receipt_digest": "Deterministic content digest of the receipt under its applicable schema.\n",
          "receipt_identity": "Stable identity of the emitted evidence artifact. Identity is distinct from the subject being evidenced.\n",
          "receipt_type": "Versioned receipt-family identity registered in this catalog or in an explicitly owned domain extension.\n",
          "verification_basis": "Evidence, criteria, references, proofs, or reproducible checks sufficient for an independent verifier to assess the receipt's bounded claim without relying only on the producer's recorded verdict.\n"
        },
        "forbidden": [
          "ambient_head_phase_or_flag_as_only_subject_binding",
          "producer_verdict_as_only_verification_basis",
          "receipt_as_authorization",
          "receipt_as_canonical_semantic_source",
          "receipt_rebinding_to_materially_changed_subject",
          "silent_result_semantic_reinterpretation"
        ],
        "required_semantics": [
          "receipt_type",
          "receipt_identity",
          "exact_subject_ref",
          "claim",
          "governing_coordinates",
          "observation_or_outcome",
          "verification_basis",
          "producer_identity",
          "receipt_digest"
        ]
      },
      "receipt_relations": {
        "current_for": {
          "object": "governing_coordinates",
          "semantics": "receipt_is_current_only_when_declared_material_coordinates_match_or_compatibility_preserves_applicability",
          "subject": "receipt"
        },
        "specializes": {
          "object": "receipt_kernel",
          "semantics": "specialization_inherits_and_may_strengthen_global_kernel",
          "subject": "receipt_family"
        },
        "verifies": {
          "object": "bounded_claim",
          "semantics": "receipt_supplies_evidence_for_claim_without_becoming_claim_authority",
          "subject": "receipt"
        }
      },
      "receipts": {
