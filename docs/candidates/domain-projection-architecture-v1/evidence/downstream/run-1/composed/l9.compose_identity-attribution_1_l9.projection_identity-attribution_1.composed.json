  },
  "payload": {
    "actor_registry": {
      "actors": [
        {
          "description": "The Cursor agent actor.",
          "id": "cursor",
          "kind": "agent",
          "status": "current"
        },
        {
          "description": "The one logical Claude Code actor. Desktop, CLI, IDE, web, and mobile are SurfaceIdentity distinctions recorded in surface_registry.yaml, never separate actors.",
          "id": "claude-code",
          "kind": "agent",
          "status": "current"
        },
        {
          "description": "The Codex agent actor.",
          "id": "codex",
          "kind": "agent",
          "status": "current"
        },
        {
          "description": "The Gemini agent actor.",
          "id": "gemini",
          "kind": "agent",
          "status": "current"
        },
        {
          "description": "The Manus agent actor.",
          "id": "manus",
          "kind": "agent",
          "status": "current"
        },
        {
          "description": "A human actor acting directly rather than through an automated agent.",
          "id": "human",
          "kind": "human",
          "status": "current"
        }
      ],
      "alias_rules": {
        "alias_does_not_authorize_new_consequential_authorship_after_downstream_migration": true,
        "alias_kinds": {
          "historical_actor_alias": "A former canonical or emitted ActorIdentity value that now canonicalizes to one current actor when read as an actor value."
        },
        "alias_meaning_is_bounded_to_actor_identity": true,
        "alias_never_shadows_a_canonical_actor": true,
        "alias_never_targets_another_alias": true,
        "alias_resolves_to_exactly_one_canonical_actor": true
      },
      "aliases": [
        {
          "alias": "claude-code-desktop",
          "alias_kind": "historical_actor_alias",
          "canonical": "claude-code",
          "note": "Historical actor value emitted by operating-plane identity derivation. When interpreted as an ActorIdentity value it canonicalizes to claude-code. The same string is a canonical SurfaceIdentity in surface_registry.yaml; equal strings do not imply equal identity kinds."
        },
        {
          "alias": "claude-code-mobile",
          "alias_kind": "historical_actor_alias",
          "canonical": "claude-code",
          "note": "Historical actor value emitted by operating-plane identity derivation. When interpreted as an ActorIdentity value it canonicalizes to claude-code. The same string is a canonical SurfaceIdentity in surface_registry.yaml; equal strings do not imply equal identity kinds."
        }
      ]
    },
    "contracts": {
      "contracts": [
        {
          "applies_to": [
            "runtime_identity_resolution",
            "actor_identity_resolution",
            "surface_identity_resolution",
            "bootstrap_identity_resolution"
          ],
          "forbidden": [
            "independent_downstream_rederivation_when_valid_assertion_exists",
            "configured_governance_profile_used_as_actor_evidence",
            "guessing_actor_from_adapter_or_provider",
            "silently_collapsing_ambiguous_runtime_evidence"
          ],
          "guarantees": [
            "same_material_evidence_uses_one_resolution_path",
            "unrecognized_evidence_remains_unknown",
            "downstream_consumers_receive_one_typed_result",
            "runtime_markers_are_evidence_not_authority"
          ],
          "id": "l9.contract/identity-resolution@1",
          "outcomes": {
            "ambiguous": "multiple_materially_distinct_identities_remain",
            "invalid": "evidence_or_binding_violates_identity_contract",
            "resolved": "required_identity_dimensions_are_resolved",
            "unknown": "evidence_is_insufficient"
          },
          "owner": "Quantum-L9/.github",
          "purpose": "Resolve dynamic runtime, constellation, actor, and surface identity from bounded runtime evidence under one canonical resolver contract and preserve Unknown rather than guess.",
          "requires": [
            "runtime_evidence",
            "applicable_product_topology",
            "applicable_identity_bindings",
            "canonical_resolver_coordinates"
          ],
          "scope": "global",
          "source_invariants": [
            "L9-IDENTITY-002",
            "L9-IDENTITY-003",
            "L9-IDENTITY-004",
            "L9-IDENTITY-005",
            "L9-UNKNOWN-001",
            "L9-PROV-001"
          ]
        },
        {
          "applies_to": [
            "identity_assertions",
            "memory_authorship",
            "consequential_receipts",
            "bootstrap_receipts",
            "governance_profile_selection"
          ],
          "forbidden": [
            "assertion_grants_missing_authorization",
            "assertion_relabels_governance_profile_as_actor",
            "consumer_silently_mutates_resolved_identity",
            "stale_assertion_consumed_after_material_evidence_change"
          ],
          "guarantees": [
            "assertion_is_evidence_not_authority",
            "assertion_preserves_resolution_provenance",
            "consumers_may_validate_or_challenge_but_not_rewrite",
            "actor_identity_is_available_to_memory_when_resolved"
          ],
          "id": "l9.contract/identity-assertion@1",
          "outcomes": {
            "invalid": "assertion_shape_or_provenance_is_invalid",
            "non_current": "material_evidence_or_coordinates_changed",
            "unknown": "required_identity_remains_unknown",
            "valid": "assertion_is_current_and_verifiable"
          },
          "owner": "Quantum-L9/.github",
          "purpose": "Define the typed provenance-bearing evidence artifact by which resolved identity is propagated to bootstrap, governance, memory, receipts, evidence, and observability consumers.",
          "requires": [
            "exact_subject_ref",
            "product_ref",
            "resolved_dimensions",
            "evidence_refs",
            "resolver_ref",
            "governing_coordinates",
            "result",
            "assertion_digest"
          ],
          "scope": "global",
          "source_invariants": [
            "L9-IDENTITY-004",
            "L9-IDENTITY-005",
            "L9-IDENTITY-006",
            "L9-PROV-001",
            "L9-COORD-001"
          ]
        }
      ]
    },
    "identity_model": {
      "consumer_rules": {
        "bootstrap": [
          "bootstrap_may_use_surface_and_runtime_identity_to_select_adapter_or_projection",
          "bootstrap_must_not_relabel_governance_profile_as_actor_identity"
        ],
        "governance": [
          "governance_profile_selection_may_consume_surface_runtime_or_actor_coordinates",
          "governance_profile_selection_does_not_change_identity"
        ],
        "memory": [
          "agent_or_memory_authorship_requires_actor_identity",
          "governance_profile_must_never_be_used_as_memory_author",
          "valid_identity_assertion_is_preferred_over_local_runtime_marker_rederivation"
        ],
        "receipts": [
          "consequential_receipts_bind_applicable_actor_identity",
          "receipts_preserve_runtime_and_product_provenance_when_material"
        ]
      },
      "global_rules": {
        "adapter_identity_is_not_actor_identity": true,
        "equal_strings_do_not_imply_equal_identity_kinds": true,
        "governance_profile_is_not_identity": true,
        "identity_assertion_is_consumed_not_rederived": true,
        "identity_dimensions_are_semantically_distinct": true,
        "identity_resolution_is_evidence_bound": true,
        "memory_authorship_uses_actor_identity": true,
        "provider_identity_is_not_actor_identity": true,
        "receipts_bind_applicable_actor_and_runtime_provenance": true,
        "runtime_identity_is_not_actor_identity": true,
        "surface_identity_is_not_actor_identity": true,
        "unknown_or_ambiguous_consequential_actor_identity_fails_closed": true
      },
      "identity_assertion": {
        "definition": "Typed provenance-bearing evidence artifact recording the resolved identity dimensions for one bounded runtime/operation context.",
        "required": [
          "subject_ref",
          "product_ref",
          "resolved_dimensions",
          "evidence_refs",
          "resolver_ref",
          "governing_coordinates",
          "result",
          "assertion_digest"
        ],
        "rules": [
          "assertion_does_not_grant_new_authority",
          "assertion_must_bind_exact_resolution_evidence",
          "material_evidence_change_invalidates_currentness",
          "downstream_may_validate_or_challenge_but_not_silently_rewrite"
        ],
        "schema_ref": "l9.schema/identity-assertion@1"
      },
      "identity_binding": {
        "allowed_fields": [
          "product_ref",
          "release_ref",
          "runtime_ref",
          "constellation_ref",
          "actor_ref",
          "surface_ref",
          "adapter_ref",
          "provider_ref",
          "governance_profile_ref",
          "contract_refs",
          "scope",
          "provenance"
        ],
        "definition": "Declared relation among identity dimensions and non-identity realization coordinates without collapsing their meanings.",
        "rules": [
          "binding_does_not_alias_identity_kinds",
          "binding_does_not_transfer_authority",
          "binding_must_preserve_each_dimension_semantics"
        ]
      },
      "identity_dimensions": {
        "actor_identity": {
          "authority_source": "actor_registry_and_identity_resolution_contract",
          "definition": "Identity of the actor attributable for an operation, authorship event, memory write, consequential action, or receipt where actor attribution is material.",
          "dynamic": true,
          "question": "Which admitted actor performed or authored this operation?"
        },
        "constellation_identity": {
          "authority_source": "constellation_admission_authority",
          "definition": "Identity used for admitted Constellation participation where the ProductKind requires independent participation.",
          "dynamic": true,
          "question": "Which admitted Constellation participant identity is this runtime using?"
        },
        "product_identity": {
          "authority_source": "product_semantic_owner",
          "definition": "Stable semantic identity of an L9 product across releases, deployments, runtimes, providers, and surfaces.",
          "dynamic": false,
          "question": "Which L9 product is this?"
        },
        "release_identity": {
          "authority_source": "release_provenance_and_admission",
          "definition": "Immutable version/revision/digest-bound realization identity of one product release.",
          "dynamic": false,
          "question": "Which exact immutable product release or artifact realization is this?"
        },
        "runtime_identity": {
          "authority_source": "runtime_identity_contract",
          "definition": "Identity of a concrete running realization, deployment, process, or consumer-inherited runtime as defined by the applicable ProductKind and topology.",
          "dynamic": true,
          "question": "Which exact running realization is participating?"
        },
        "surface_identity": {
          "authority_source": "surface_registry_and_runtime_evidence",
          "definition": "Identity of the concrete user/runtime interaction surface through which an actor is operating, distinct from the actor, adapter, provider, and governance profile.",
          "dynamic": true,
          "question": "Through which execution or interaction surface is the actor operating?"
        }
      },
      "identity_resolution": {
        "definition": "Evidence-bound determination of applicable dynamic identity dimensions for one runtime context.",
        "inputs": [
          "runtime_evidence",
          "applicable_product_topology",
          "identity_binding_catalog_or_registry",
          "governing_identity_contracts"
        ],
        "result_domain": [
          "resolved",
          "unknown",
          "ambiguous",
          "invalid"
        ],
        "rules": [
          "classify_once_for_same_evidence_and_coordinates",
          "downstream_consumers_do_not_independently_rederive",
          "runtime_markers_are_evidence_not_authority",
          "configured_profile_string_is_not_actor_evidence",
          "unrecognized_runtime_evidence_remains_unknown"
        ]
      },
      "non_identity_dimensions": {
        "adapter_identity": {
          "definition": "Identity of the integration adapter used to realize a boundary. It is not actor identity."
        },
        "governance_profile": {
          "definition": "Policy/autonomy profile selected for a runtime/surface. It is not an identity dimension and cannot be used as authorship."
        },
        "provider_identity": {
          "definition": "Identity of the underlying provider/tool/runtime mechanism. It is not actor identity."
        }
      }
    },
    "invariants": {
      "invariants": [
        {
          "id": "L9-AUTH-001",
          "owner": "Quantum-L9/.github",
          "scope": "global",
          "statement": "No component may expand its own authority.\n"
        },
        {
          "id": "L9-EVIDENCE-001",
          "owner": "Quantum-L9/.github",
          "scope": "global",
          "statement": "Evidence and receipts attest only to the observations or outcomes declared by their contracts; they confer neither semantic nor execution authority.\n"
        },
        {
          "id": "L9-UNKNOWN-001",
          "owner": "Quantum-L9/.github",
          "scope": "global",
          "statement": "Missing, unknown, unresolved, conflicting, unavailable, or unproven inputs, claims, or results remain explicit; they must not be silently coerced, reconciled, or treated as establishing a value, compatibility, validity, authorization, or success. An applicable authoritative rule may resolve a conflict, but authority does not manufacture missing evidence or establish an unproven claim.\n"
        },
        {
          "id": "L9-PROV-001",
          "owner": "Quantum-L9/.github",
          "scope": "global",
          "statement": "Every derived semantic artifact must preserve enough provenance to resolve its authoritative inputs and the declared transformations and coordinates that produced it.\n"
        },
        {
          "id": "L9-COORD-001",
          "owner": "Quantum-L9/.github",
          "scope": "global",
          "statement": "A derived result is valid only against its declared governing coordinates; a material coordinate change makes it non-current until compatibility is proven or it is recomputed.\n"
        },
        {
          "id": "L9-IDENTITY-001",
          "owner": "Quantum-L9/.github",
          "scope": "global",
          "statement": "A change of representation, provider, implementation, transport, or storage does not by itself change semantic identity.\n"
        },
        {
          "id": "L9-COMPAT-001",
          "owner": "Quantum-L9/.github",
          "scope": "global",
          "statement": "Semantic equivalence and compatibility must be declared by the applicable type or contract; similarity, convenience, or successful execution must not substitute for them.\n"
        },
        {
          "id": "L9-PROJECTION-001",
          "owner": "Quantum-L9/.github",
          "scope": "global",
          "statement": "A projection is a bounded view of existing source semantics; it may select or reshape representation but may not invent, reconcile, reinterpret, or expand source meaning or authority. A transformation that introduces semantic consequences is not projection and must be classified under another applicable governed operation.\n"
        },
        {
          "id": "L9-IDENTITY-002",
          "owner": "Quantum-L9/.github",
          "scope": "global",
          "statement": "Identity dimensions including product, release, runtime, constellation, actor, and surface identity have distinct semantics; equality of string representation does not make two identity kinds equivalent."
        },
        {
          "id": "L9-IDENTITY-003",
          "owner": "Quantum-L9/.github",
          "scope": "global",
          "statement": "Governance profile, adapter identity, provider identity, transport identity, and surface identity must not be substituted for ActorIdentity or used as consequential operation authorship."
        },
        {
          "id": "L9-IDENTITY-004",
          "owner": "Quantum-L9/.github",
          "scope": "global",
          "statement": "Dynamic identity resolution must be evidence-bound and canonical for its scope; downstream consumers must consume a valid IdentityAssertion rather than independently re-derive identity from the same runtime evidence."
        },
        {
          "id": "L9-IDENTITY-005",
          "owner": "Quantum-L9/.github",
          "scope": "global",
          "statement": "Unknown or ambiguous ActorIdentity must remain explicit and fail closed when consequential authorship, authorization, memory attribution, or receipt attribution requires a resolved actor."
        },
        {
          "id": "L9-IDENTITY-006",
          "owner": "Quantum-L9/.github",
          "scope": "global",
          "statement": "IdentityAssertion must preserve the exact evidence, resolver, governing coordinates, and provenance supporting the resolved identity dimensions; material evidence or coordinate change invalidates currentness."
        }
      ]
    },
    "surface_registry": {
      "alias_rules": {
