    "invariants": {
      "invariants": [
        {
          "id": "L9-AUTH-001",
          "owner": "Quantum-L9/.github",
          "scope": "global",
          "statement": "No component may expand its own authority.\n"
        },
        {
          "id": "L9-AUTH-002",
          "owner": "Quantum-L9/.github",
          "scope": "global",
          "statement": "Capability to perform a function does not confer authority over the governing decision or action.\n"
        },
        {
          "id": "L9-OWNER-001",
          "owner": "Quantum-L9/.github",
          "scope": "global",
          "statement": "Within a given semantic scope and revision, each canonical concept has one authoritative owner; mirroring, projection, consumption, implementation, dependency, co-location, or execution by another component does not by itself transfer ownership or create a competing canonical source.\n"
        },
        {
          "id": "L9-SEM-001",
          "owner": "Quantum-L9/.github",
          "scope": "global",
          "statement": "Provider identity does not imply semantic ownership.\n"
        },
        {
          "id": "L9-SCOPE-001",
          "owner": "Quantum-L9/.github",
          "scope": "global",
          "statement": "Global admission of a generalized law does not transfer ownership of the originating domain semantics; the admitted global law and the originating domain semantics remain separately owned.\n"
        },
        {
          "id": "L9-MONOTONIC-001",
          "owner": "Quantum-L9/.github",
          "scope": "global",
          "statement": "Where canonical law permits subordinate extension, a subordinate policy may narrow permissions or strengthen applicable constraints within its delegated scope; it must not weaken, bypass, reinterpret, shadow, or replace canonical law except through authority explicitly delegated by the canonical owner.\n"
        },
        {
          "id": "L9-PROMOTION-001",
          "owner": "Quantum-L9/.github",
          "scope": "global",
          "statement": "A semantic artifact or result does not acquire a stronger semantic or authority class merely by being produced, consumed, repeated, or validated; promotion requires explicit admission by the authority that owns the target semantic or authority class.\n"
        },
        {
          "id": "L9-DERIVED-001",
          "owner": "Quantum-L9/.github",
          "scope": "global",
          "statement": "Derived artifacts do not become canonical authority automatically.\n"
        },
        {
          "id": "L9-UNKNOWN-001",
          "owner": "Quantum-L9/.github",
          "scope": "global",
          "statement": "Missing, unknown, unresolved, conflicting, unavailable, or unproven inputs, claims, or results remain explicit; they must not be silently coerced, reconciled, or treated as establishing a value, compatibility, validity, authorization, or success. An applicable authoritative rule may resolve a conflict, but authority does not manufacture missing evidence or establish an unproven claim.\n"
        },
        {
          "id": "L9-PROV-001",
          "owner": "Quantum-L9/.github",
          "scope": "global",
          "statement": "Every derived semantic artifact must preserve enough provenance to resolve its authoritative inputs and the declared transformations and coordinates that produced it.\n"
        },
        {
          "id": "L9-COMPAT-001",
          "owner": "Quantum-L9/.github",
          "scope": "global",
          "statement": "Semantic equivalence and compatibility must be declared by the applicable type or contract; similarity, convenience, or successful execution must not substitute for them.\n"
        },
        {
          "id": "L9-REVISION-001",
          "owner": "Quantum-L9/.github",
          "scope": "global",
          "statement": "The semantic content of an admitted revision is immutable; correction or change creates a successor or supersession rather than rewriting prior meaning.\n"
        },
        {
          "id": "L9-ADMISSION-001",
          "owner": "Quantum-L9/.github",
          "scope": "global",
          "statement": "Authority and admission decisions are bound to the exact subject revision they evaluate; a material change to that subject requires a new decision unless an explicit governing contract preserves compatibility.\n"
        },
        {
          "id": "L9-PROJECTION-001",
          "owner": "Quantum-L9/.github",
          "scope": "global",
          "statement": "A projection is a bounded view of existing source semantics; it may select or reshape representation but may not invent, reconcile, reinterpret, or expand source meaning or authority. A transformation that introduces semantic consequences is not projection and must be classified under another applicable governed operation.\n"
        },
        {
          "id": "L9-GLOBALIZATION-001",
          "owner": "Quantum-L9/.github",
          "scope": "global",
          "statement": "Recurrence or pattern recognition may justify a globalization candidate but never creates global law; global law requires explicit admission by the global authority.\n"
        }
      ]
    },
