  "payload": {
    "capabilities": {
      "capabilities": [],
      "capability_entry_contract": {
        "field_semantics": {
          "authorization_requirements": "Explicit authority conditions that apply to invocation. These requirements do not themselves constitute an authorization decision.\n",
          "effect_class": "Explicit semantic classification of the kind of governed effect the capability may produce. The class must resolve within the capability's semantic scope. Effect class informs applicable contracts and policy but does not itself grant authority or imply global scope.\n",
          "id": "Stable semantic capability identity. Provider, implementation, transport, or storage identity must not define this identity.\n",
          "purpose": "Bounded description of the semantic function exposed by the capability.\n",
          "requires": "Explicit semantic capability dependencies and global contract dependencies that must be satisfied for applicable use.\n",
          "semantic_owner": "Authority that owns the capability meaning. Registration in this global catalog does not transfer that ownership to the catalog owner.\n",
          "semantic_scope": "Scope within which the capability meaning is authoritative. Global registration does not imply global semantic scope.\n"
        },
        "prohibited_fields": [
          "provider_as_semantic_owner",
          "implicit_authorization",
          "implicit_availability",
          "implicit_admission",
          "inline_provider_implementation"
        ],
        "required_fields": [
          "id",
          "semantic_owner",
          "semantic_scope",
          "purpose",
          "effect_class",
          "requires",
          "authorization_requirements"
        ]
      },
      "capability_relations": {
        "compatible_with": {
          "authority_implication": "none",
          "object": "semantic_capability",
          "semantics": "Capability compatibility exists only when an applicable declared compatibility contract establishes it. Similarity or successful execution is insufficient. Compatibility among concrete realizations is outside this relation and remains owned by binding_catalog.yaml.\n",
          "subject": "semantic_capability"
        },
        "realized_by": {
          "authority_implication": "none",
          "object": "provider_binding",
          "ownership_implication": "none",
          "semantics": "A provider binding realizes the semantic capability without changing the capability identity or semantic owner.\n",
          "subject": "semantic_capability"
        },
        "requires": {
          "authority_implication": "none",
          "object": "semantic_capability",
          "semantics": "The subject capability depends on the object capability being satisfied according to the subject capability's applicable contracts.\n",
          "state_implication": "none",
          "subject": "semantic_capability"
        }
      },
      "capability_state_dimensions": {
        "admitted": {
          "authority_source": "applicable_admission_authority",
          "definition": "The exact capability declaration has been accepted by the applicable admission authority for the relevant semantic scope.\n",
          "implies": []
        },
        "authorized": {
          "authority_source": "governing_authority",
          "definition": "The governing authority permits the subject to invoke the capability within the declared scope and context.\n",
          "implies": []
        },
        "available": {
          "authority_source": "applicable_availability_fact_source",
          "definition": "A realization is reported as currently usable at the relevant runtime coordinates. Availability is a runtime fact and does not itself establish authorization, conformance, or semantic ownership.\n",
          "implies": []
        },
        "declared": {
          "authority_source": "semantic_owner",
          "definition": "The semantic owner has explicitly defined the capability identity and its semantic definition at an exact version or revision.\n",
          "implies": []
        },
        "invocable": {
          "authority_source": "derived_contract_evaluation",
          "definition": "A derived evaluation that all capability states, requirements, authority, and preconditions required by the applicable canonical contracts are satisfied for a specific invocation attempt.\n",
          "derived": true,
          "implies": []
        }
      },
      "global_rules": {
        "capability_identity_is_not_provider_identity": true,
        "capability_identity_is_semantic": true,
        "catalog_registration_does_not_expand_authority": true,
        "component_capabilities_are_not_globalized_by_recurrence": true,
        "declaration_admission_availability_authorization_and_invocability_are_distinct": true,
        "effect_class_does_not_grant_authority": true,
        "effect_class_must_be_explicit": true,
        "invocability_is_derived_not_self_granted": true,
        "provider_realization_does_not_transfer_semantic_ownership": true,
        "provider_realization_is_separate_from_semantic_capability_identity": true,
        "requirements_must_be_declared": true,
        "semantic_owner_must_be_explicit": true,
        "semantic_scope_must_be_explicit": true,
        "state_dimensions_do_not_imply_a_lifecycle_order": true,
        "technology_registration_does_not_authorize_capability_use": true,
        "unknown_state_must_remain_explicit": true
      },
      "invocability_contract": {
        "forbidden": [
          "self_authorization",
          "inference_from_declaration_only",
          "inference_from_availability_only",
          "inference_from_provider_presence",
          "inference_from_previous_success",
          "inference_from_unknown_or_unresolved_state"
        ],
        "kind": "derived_predicate",
        "rule": "A capability is invocable only when every state dimension required by its applicable canonical contracts is satisfied, all declared semantic requirements and applicable authorization requirements are satisfied for the invocation scope, and no applicable hard constraint is unresolved or violated.\n"
      }
    },
    "capability_resolution": {
      "inputs": [
        "desired_capability_refs",
        "capability_catalog_projection",
        "applicable_contract_projection",
        "authority_projection",
        "requirement_closure"
      ],
      "outputs": {
        "capability_closure_ir": "Exact desired and transitive semantic capability closure with provenance.",
        "unresolved_capability_refs": "Capabilities whose meaning, owner, dependency, or governing contract cannot be resolved."
      },
      "resolution_order": [
        "resolve_semantic_identity",
        "resolve_semantic_owner",
        "resolve_required_capabilities",
        "resolve_applicable_contracts",
        "resolve_authorization_requirements",
        "emit_capability_closure"
      ],
      "rules": [
        "capability_identity_is_provider_independent",
        "dependency_closure_does_not_imply_availability_or_authorization",
        "unregistered_component_local_capability_may_be_resolved_only_from_its_semantic_owner_source",
        "missing_capability_semantics_remain_unresolved",
        "closure_preserves_all_source_coordinates"
      ]
    },
    "contracts": {
      "contracts": [
        {
          "applies_to": [
            "missing_inputs",
            "unresolved_results",
            "conflicting_authoritative_claims",
            "unavailable_capabilities",
            "degraded_execution",
            "fallback_paths"
          ],
          "forbidden": [
            "coercing_unknown_to_default_value",
            "coercing_unknown_to_success_failure_validity_or_authorization",
            "silent_conflict_reconciliation",
            "authority_declaration_as_substitute_for_missing_evidence",
            "silent_semantic_fallback",
            "cross_owner_impersonation_without_compatibility_and_authority"
          ],
          "guarantees": [
            "unknown_remains_distinguishable_from_known_values_and_success",
            "conflicting_semantics_are_not_silently_reconciled",
            "conflict_resolution_does_not_manufacture_missing_evidence_or_prove_unproven_claims",
            "unavailable_semantics_are_not_replaced_by_undeclared_fallbacks",
            "authorized_compatible_substitution_preserves_declared_semantic_guarantees"
          ],
          "id": "l9.contract/unknown-and-degradation@1",
          "outcomes": {
            "refused": "requested_substitution_lacks_compatibility_or_authority",
            "resolved": "required_semantics_are_known_or_validly_substituted_or_conflict_is_authoritatively_resolved",
            "unresolved": "unknown_unavailable_or_conflicting_semantics_remain_explicit"
          },
          "owner": "Quantum-L9/.github",
          "purpose": "Preserve unknown, unresolved, and conflicting semantics and constrain degraded behavior so unavailable capabilities cannot silently impersonate other semantic owners.\n",
          "requires": [
            "unknown_or_unavailable_state_is_explicit",
            "conflicting_semantics_remain_explicit_until_resolved_by_applicable_authoritative_rule_or_decision",
            "substitution_has_explicit_compatibility_contract_when_attempted",
            "substitution_has_applicable_authority_when_attempted"
          ],
          "scope": "global",
          "source_invariants": [
            "L9-UNKNOWN-001",
            "L9-DEGRADE-001",
            "L9-COMPAT-001",
            "L9-AUTH-001"
          ]
        },
        {
          "applies_to": [
            "capability_catalogs",
            "capability_admission",
            "capability_availability",
            "authorization",
            "invocation"
          ],
          "forbidden": [
            "treating_declaration_as_admission",
            "treating_admission_as_availability",
            "treating_availability_as_authorization",
            "treating_authorization_as_availability",
            "treating_any_single_state_as_invocability_without_required_contract_conditions"
          ],
          "guarantees": [
            "declaration_admission_availability_authorization_and_invocability_remain_distinct",
            "no_state_implies_another_without_declared_contract_semantics",
            "invocation_does_not_create_missing_authorization_or_admission"
          ],
          "id": "l9.contract/capability-state@1",
          "outcomes": {
            "invocable": "all_contract_required_states_and_authority_are_satisfied",
            "not_invocable": "one_or_more_required_states_or_authority_conditions_fail",
            "unresolved": "one_or_more_required_capability_states_cannot_be_resolved"
          },
          "owner": "Quantum-L9/.github",
          "purpose": "Preserve the distinction among capability declaration, admission, availability, authorization, and invocability.\n",
          "requires": [
            "each_relevant_capability_state_is_explicit",
            "state_implications_are_defined_only_by_applicable_canonical_contract",
            "invocation_satisfies_all_required_states_and_authority"
          ],
          "scope": "global",
          "source_invariants": [
            "L9-CAPABILITY-001",
            "L9-AUTH-001",
            "L9-PROMOTION-001"
          ]
        }
      ]
    },
